# IP or hostname of the TV on the local network
BRAVIA_HOST=

# Pre-shared key configured on the TV (Settings > Network > IP Control)
BRAVIA_PSK=

# MAC address of the TV, for the Wake-on-LAN fallback (optional)
BRAVIA_MAC=

# http (default) or https
BRAVIA_SCHEME=http

# Maximum volume allowed client-side (optional)
BRAVIA_MAX_VOLUME=100
